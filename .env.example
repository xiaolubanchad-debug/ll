# Run npm run setup:env to generate a local .env with random secrets.
NODE_ENV=development
APP_ORIGIN=http://127.0.0.1:5173
HOST=127.0.0.1
PORT=3000
COOKIE_SECURE=false
TRUST_PROXY_HOPS=0
SESSION_CSRF_KEY=
DATABASE_URL=
POSTGRES_PASSWORD=
# Generated by npm run setup:deployment; never commit the key files.
MASTER_KEY_FILE=
RELEASE_PRIVATE_KEY_FILE=
RELEASE_PUBLIC_KEY_FILE=
RELEASE_DIR=
CONTROL_PLANE_URL=
# Separate restricted Worker connection: data/keys/worker-url.env
