{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.apk-platform.example/v1/v119.schema.json",
  "$defs": {
    "ManualApkCreateInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {},
      "required": []
    },
    "ManualApkView": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "status": {
          "enum": [
            "UPLOADING",
            "RECEIVING",
            "QUEUED",
            "IMPORTING",
            "APPLIED",
            "FAILED",
            "CANCELLED",
            "EXPIRED",
            "NEEDS_REVIEW"
          ]
        },
        "apk": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "packageName",
                "versionName",
                "versionCode",
                "abis",
                "size",
                "apkSha256",
                "cacheDay"
              ],
              "properties": {
                "packageName": {
                  "type": "string",
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_]*(\\.[a-zA-Z][a-zA-Z0-9_]*)+$",
                  "maxLength": 256
                },
                "versionName": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 256
                },
                "versionCode": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "abis": {
                  "type": "array",
                  "uniqueItems": true,
                  "maxItems": 20,
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{1,40}$"
                  }
                },
                "size": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 536870912
                },
                "apkSha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "cacheDay": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                },
                "minSdkVersion": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000
                },
                "validationPolicy": {
                  "enum": [
                    "ANDROID_INSTALL"
                  ]
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "errorCode": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "operationId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "maxBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 536870912
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "status",
        "apk",
        "errorCode",
        "operationId",
        "maxBytes",
        "createdAt",
        "updatedAt"
      ]
    },
    "ManualApkImportInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "nodeId": {
          "type": "string",
          "format": "uuid"
        },
        "cacheDay": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "targetKey": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "apk": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "packageName",
            "versionName",
            "versionCode",
            "abis",
            "size",
            "apkSha256",
            "cacheDay"
          ],
          "properties": {
            "packageName": {
              "type": "string",
              "pattern": "^[a-zA-Z][a-zA-Z0-9_]*(\\.[a-zA-Z][a-zA-Z0-9_]*)+$",
              "maxLength": 256
            },
            "versionName": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 256
            },
            "versionCode": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "abis": {
              "type": "array",
              "uniqueItems": true,
              "maxItems": 20,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,40}$"
              }
            },
            "size": {
              "type": "integer",
              "minimum": 1,
              "maximum": 536870912
            },
            "apkSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "cacheDay": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "minSdkVersion": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "validationPolicy": {
              "enum": [
                "ANDROID_INSTALL"
              ]
            }
          }
        },
        "maxBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 536870912
        }
      },
      "required": [
        "id",
        "nodeId",
        "cacheDay",
        "targetKey",
        "apk",
        "maxBytes"
      ]
    },
    "ManualApkImportReceipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "status": {
          "const": "CACHED"
        },
        "cacheKey": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "apk": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "packageName",
            "versionName",
            "versionCode",
            "abis",
            "size",
            "apkSha256",
            "cacheDay"
          ],
          "properties": {
            "packageName": {
              "type": "string",
              "pattern": "^[a-zA-Z][a-zA-Z0-9_]*(\\.[a-zA-Z][a-zA-Z0-9_]*)+$",
              "maxLength": 256
            },
            "versionName": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 256
            },
            "versionCode": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "abis": {
              "type": "array",
              "uniqueItems": true,
              "maxItems": 20,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,40}$"
              }
            },
            "size": {
              "type": "integer",
              "minimum": 1,
              "maximum": 536870912
            },
            "apkSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "cacheDay": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "minSdkVersion": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "validationPolicy": {
              "enum": [
                "ANDROID_INSTALL"
              ]
            }
          }
        }
      },
      "required": [
        "id",
        "status",
        "cacheKey",
        "apk"
      ]
    }
  }
}
