{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.apk-platform.example/v1/agent.schema.json",
  "title": "APK node protocol 1.0 messages",
  "oneOf": [
    {
      "$ref": "#/$defs/enroll"
    },
    {
      "$ref": "#/$defs/heartbeat"
    },
    {
      "$ref": "#/$defs/claim"
    },
    {
      "$ref": "#/$defs/delivery"
    },
    {
      "$ref": "#/$defs/accept"
    },
    {
      "$ref": "#/$defs/events"
    },
    {
      "$ref": "#/$defs/account"
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "enroll": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "protocolVersion", "nodeId", "bootId", "agentVersion", "releaseId"],
      "properties": {
        "kind": {
          "const": "enroll"
        },
        "protocolVersion": {
          "const": "1.0"
        },
        "nodeId": {
          "$ref": "#/$defs/uuid"
        },
        "bootId": {
          "$ref": "#/$defs/uuid"
        },
        "agentVersion": {
          "$ref": "#/$defs/version"
        },
        "releaseId": {
          "$ref": "#/$defs/uuid"
        }
      }
    },
    "currentDelivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deliveryId", "runId", "fence"],
      "properties": {
        "deliveryId": {
          "$ref": "#/$defs/uuid"
        },
        "runId": {
          "$ref": "#/$defs/uuid"
        },
        "fence": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "heartbeat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "protocolVersion",
        "nodeId",
        "bootId",
        "agentVersion",
        "releaseId",
        "sentAt",
        "capabilities",
        "currentDelivery"
      ],
      "properties": {
        "kind": {
          "const": "heartbeat"
        },
        "protocolVersion": {
          "const": "1.0"
        },
        "nodeId": {
          "$ref": "#/$defs/uuid"
        },
        "bootId": {
          "$ref": "#/$defs/uuid"
        },
        "agentVersion": {
          "$ref": "#/$defs/version"
        },
        "releaseId": {
          "$ref": "#/$defs/uuid"
        },
        "sentAt": {
          "$ref": "#/$defs/time"
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["download", "android", "kvm", "freeDiskBytes"],
          "properties": {
            "download": {
              "type": "boolean"
            },
            "android": {
              "type": "boolean"
            },
            "kvm": {
              "type": "boolean"
            },
            "freeDiskBytes": {
              "type": "integer",
              "minimum": 0
            },
            "downloadProtocol": {
              "const": "1.0"
            },
            "registrationProtocol": {
              "const": "1.0"
            }
          }
        },
        "currentDelivery": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/currentDelivery"
            }
          ]
        },
        "report": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ubuntu",
            "arch",
            "memoryKiB",
            "freeDiskBytes",
            "kvm",
            "sudo",
            "markerPresent",
            "android",
            "download",
            "versions",
            "errors"
          ],
          "properties": {
            "ubuntu": {
              "type": "string",
              "maxLength": 32
            },
            "arch": {
              "type": "string",
              "maxLength": 32
            },
            "memoryKiB": {
              "type": "integer",
              "minimum": 0
            },
            "freeDiskBytes": {
              "type": "integer",
              "minimum": 0
            },
            "kvm": {
              "type": "boolean"
            },
            "sudo": {
              "type": "boolean"
            },
            "markerPresent": {
              "type": "boolean"
            },
            "android": {
              "type": "boolean"
            },
            "download": {
              "type": "boolean"
            },
            "versions": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "node": {
                  "type": "string",
                  "maxLength": 100
                },
                "adb": {
                  "type": "string",
                  "maxLength": 100
                },
                "emulator": {
                  "type": "string",
                  "maxLength": 100
                },
                "appium": {
                  "type": "string",
                  "maxLength": 100
                },
                "playwright": {
                  "type": "string",
                  "maxLength": 100
                },
                "systemImage": {
                  "type": "string",
                  "maxLength": 100
                },
                "identityModels": {
                  "type": "string",
                  "pattern": "^([0-9]|[12][0-9]|30)$"
                },
                "identityCatalog": {
                  "type": "string",
                  "maxLength": 2000
                },
                "identityAbis": {
                  "type": "string",
                  "maxLength": 4000
                }
              }
            },
            "errors": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "enum": [
                  "NO_KVM",
                  "DISK_LOW",
                  "UNSUPPORTED_OS",
                  "UNSUPPORTED_ARCH",
                  "SUDO_REQUIRED",
                  "ANDROID_NOT_READY",
                  "INSTALL_IN_PROGRESS"
                ]
              }
            }
          }
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "protocolVersion", "nodeId", "bootId"],
      "properties": {
        "kind": {
          "const": "claim"
        },
        "protocolVersion": {
          "const": "1.0"
        },
        "nodeId": {
          "$ref": "#/$defs/uuid"
        },
        "bootId": {
          "$ref": "#/$defs/uuid"
        }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "protocolVersion",
        "nodeId",
        "deliveryId",
        "runId",
        "fence",
        "configVersionId",
        "configHash",
        "releaseId",
        "issuedAt",
        "ackDeadline",
        "leaseExpiresAt"
      ],
      "properties": {
        "kind": {
          "const": "delivery"
        },
        "protocolVersion": {
          "const": "1.0"
        },
        "nodeId": {
          "$ref": "#/$defs/uuid"
        },
        "deliveryId": {
          "$ref": "#/$defs/uuid"
        },
        "runId": {
          "$ref": "#/$defs/uuid"
        },
        "fence": {
          "type": "integer",
          "minimum": 1
        },
        "configVersionId": {
          "$ref": "#/$defs/uuid"
        },
        "configHash": {
          "$ref": "#/$defs/hash"
        },
        "releaseId": {
          "$ref": "#/$defs/uuid"
        },
        "issuedAt": {
          "$ref": "#/$defs/time"
        },
        "ackDeadline": {
          "$ref": "#/$defs/time"
        },
        "leaseExpiresAt": {
          "$ref": "#/$defs/time"
        }
      }
    },
    "accept": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "protocolVersion", "nodeId", "bootId", "deliveryId", "fence"],
      "properties": {
        "kind": {
          "const": "accept"
        },
        "protocolVersion": {
          "const": "1.0"
        },
        "nodeId": {
          "$ref": "#/$defs/uuid"
        },
        "bootId": {
          "$ref": "#/$defs/uuid"
        },
        "deliveryId": {
          "$ref": "#/$defs/uuid"
        },
        "fence": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "events": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "protocolVersion", "nodeId", "deliveryId", "fence", "events"],
      "properties": {
        "kind": {
          "const": "events"
        },
        "protocolVersion": {
          "const": "1.0"
        },
        "nodeId": {
          "$ref": "#/$defs/uuid"
        },
        "deliveryId": {
          "$ref": "#/$defs/uuid"
        },
        "fence": {
          "type": "integer",
          "minimum": 1
        },
        "events": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/event"
          }
        }
      }
    },
    "account": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "protocolVersion",
        "nodeId",
        "deliveryId",
        "fence",
        "taskId",
        "accountRef",
        "username",
        "password"
      ],
      "properties": {
        "kind": {
          "const": "account"
        },
        "protocolVersion": {
          "const": "1.0"
        },
        "nodeId": {
          "$ref": "#/$defs/uuid"
        },
        "deliveryId": {
          "$ref": "#/$defs/uuid"
        },
        "fence": {
          "type": "integer",
          "minimum": 1
        },
        "taskId": {
          "$ref": "#/$defs/uuid"
        },
        "accountRef": {
          "$ref": "#/$defs/uuid"
        },
        "username": {
          "type": "string",
          "pattern": "^[a-zA-Z]{6,10}$"
        },
        "password": {
          "type": "string",
          "minLength": 8,
          "maxLength": 12,
          "pattern": "^(?=.*[a-zA-Z])(?=.*[0-9])[a-zA-Z0-9]+$"
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eventId", "runId", "sequence", "occurredAt", "type", "payload"],
      "properties": {
        "eventId": {
          "$ref": "#/$defs/uuid"
        },
        "runId": {
          "$ref": "#/$defs/uuid"
        },
        "taskId": {
          "$ref": "#/$defs/uuid"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "occurredAt": {
          "$ref": "#/$defs/time"
        },
        "type": {
          "enum": [
            "RUN_STARTED",
            "TARGETS_DISCOVERED",
            "TASK_STAGE",
            "SUBMISSION_INTENT",
            "TASK_FINISHED",
            "RUN_FINISHED",
            "STOP_ACK",
            "LOG",
            "PROXY_CHECKED",
            "BROWSER_ENVIRONMENT",
            "APP_OBSTRUCTION",
            "DEVICE_SESSION"
          ]
        },
        "payload": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "RUN_STARTED"
              }
            },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/runStarted"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "TARGETS_DISCOVERED"
              }
            },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/targets"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "TASK_STAGE"
              }
            },
            "required": ["type"]
          },
          "then": {
            "required": ["taskId"],
            "properties": {
              "payload": {
                "$ref": "#/$defs/taskStage"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "SUBMISSION_INTENT"
              }
            },
            "required": ["type"]
          },
          "then": {
            "required": ["taskId"],
            "properties": {
              "payload": {
                "$ref": "#/$defs/submission"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "TASK_FINISHED"
              }
            },
            "required": ["type"]
          },
          "then": {
            "required": ["taskId"],
            "properties": {
              "payload": {
                "$ref": "#/$defs/taskFinished"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "RUN_FINISHED"
              }
            },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/runFinished"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "STOP_ACK"
              }
            },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/stopAck"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "LOG"
              }
            },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/log"
              }
            },
            "required": ["taskId"]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "PROXY_CHECKED"
              }
            },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/proxyChecked"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "BROWSER_ENVIRONMENT"
              }
            },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/browserEnvironment"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "APP_OBSTRUCTION"
              }
            },
            "required": ["type"]
          },
          "then": {
            "required": ["taskId"],
            "properties": {
              "payload": {
                "$ref": "#/$defs/appObstruction"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "DEVICE_SESSION"
              }
            },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/deviceSession"
              }
            }
          }
        }
      ]
    },
    "runStarted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["configHash", "releaseId"],
      "properties": {
        "configHash": {
          "$ref": "#/$defs/hash"
        },
        "releaseId": {
          "$ref": "#/$defs/uuid"
        }
      }
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targets"],
      "properties": {
        "targets": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["taskId", "targetKey", "label", "sourceUrl"],
            "properties": {
              "taskId": {
                "$ref": "#/$defs/uuid"
              },
              "targetKey": {
                "$ref": "#/$defs/hash"
              },
              "label": {
                "type": "string",
                "maxLength": 200
              },
              "sourceUrl": {
                "type": "string",
                "format": "uri",
                "pattern": "^https?://",
                "maxLength": 4096
              },
              "entryId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._:-]{1,100}$"
              }
            }
          }
        },
        "complete": {
          "type": "boolean"
        },
        "startIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        }
      }
    },
    "taskStage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage"],
      "properties": {
        "stage": {
          "enum": [
            "QUEUED",
            "DOWNLOADING",
            "DOWNLOADED",
            "PREPARING",
            "INSTALLING",
            "LAUNCHING",
            "REGISTERING",
            "VERIFYING",
            "DISCOVERING",
            "HOLDING"
          ]
        },
        "cacheHit": {
          "type": "boolean"
        },
        "packageName": {
          "type": "string",
          "maxLength": 256
        },
        "apkSha256": {
          "$ref": "#/$defs/hash"
        },
        "deviceProfileId": {
          "type": "string",
          "maxLength": 64
        },
        "apk": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "packageName",
            "versionName",
            "versionCode",
            "abis",
            "size",
            "apkSha256",
            "cacheDay"
          ],
          "properties": {
            "packageName": {
              "type": "string",
              "pattern": "^[a-zA-Z][a-zA-Z0-9_]*(\\.[a-zA-Z][a-zA-Z0-9_]*)+$",
              "maxLength": 256
            },
            "versionName": {
              "type": ["string", "null"],
              "maxLength": 256
            },
            "versionCode": {
              "type": ["integer", "null"],
              "minimum": 0
            },
            "abis": {
              "type": "array",
              "uniqueItems": true,
              "maxItems": 20,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,40}$"
              }
            },
            "size": {
              "type": "integer",
              "minimum": 1,
              "maximum": 536870912
            },
            "apkSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "cacheDay": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "minSdkVersion": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            }
          }
        },
        "observation": {
          "$ref": "#/$defs/deviceObservation"
        },
        "recognition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "navigationSteps", "cache", "learned", "needsAdaptation"],
          "properties": {
            "source": {
              "enum": ["CONTROLS", "OCR", "LEARNED"]
            },
            "navigationSteps": {
              "type": "integer",
              "minimum": 0,
              "maximum": 12
            },
            "cache": {
              "enum": ["MISS", "HIT", "INVALIDATED"]
            },
            "learned": {
              "type": "boolean"
            },
            "needsAdaptation": {
              "type": "boolean"
            },
            "templateHash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "automaticIdentity": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "identifierHash", "scope"],
              "properties": {
                "kind": {
                  "enum": ["GUEST", "APP_ASSIGNED"]
                },
                "identifierHash": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "scope": {
                  "const": "APP_UI_ONLY"
                }
              }
            }
          }
        },
        "minSdkVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      }
    },
    "submission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["submissionId", "accountRef"],
      "properties": {
        "submissionId": {
          "$ref": "#/$defs/uuid"
        },
        "accountRef": {
          "$ref": "#/$defs/uuid"
        }
      }
    },
    "taskFinished": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "proof", "artifactIds"],
      "properties": {
        "status": {
          "enum": ["SUCCEEDED", "FAILED", "SKIPPED", "CANCELLED", "UNKNOWN"]
        },
        "proof": {
          "enum": ["APP_UI", "FILE_VALIDATION", "NONE", "APP_OPEN"]
        },
        "artifactIds": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/uuid"
          }
        },
        "accountRef": {
          "$ref": "#/$defs/uuid"
        },
        "errorCode": {
          "type": "string",
          "pattern": "^[A-Z_]+$",
          "maxLength": 100
        },
        "recognition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "navigationSteps", "cache", "learned", "needsAdaptation"],
          "properties": {
            "source": {
              "enum": ["CONTROLS", "OCR", "LEARNED"]
            },
            "navigationSteps": {
              "type": "integer",
              "minimum": 0,
              "maximum": 12
            },
            "cache": {
              "enum": ["MISS", "HIT", "INVALIDATED"]
            },
            "learned": {
              "type": "boolean"
            },
            "needsAdaptation": {
              "type": "boolean"
            },
            "templateHash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "automaticIdentity": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "identifierHash", "scope"],
              "properties": {
                "kind": {
                  "enum": ["GUEST", "APP_ASSIGNED"]
                },
                "identifierHash": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "scope": {
                  "const": "APP_UI_ONLY"
                }
              }
            }
          }
        },
        "openObservation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["dwellMs", "elapsedMs", "samples", "scope", "cleanupComplete"],
          "properties": {
            "dwellMs": {
              "const": 10000
            },
            "elapsedMs": {
              "type": "integer",
              "minimum": 10000,
              "maximum": 60000
            },
            "samples": {
              "type": "integer",
              "minimum": 2,
              "maximum": 200
            },
            "scope": {
              "const": "FOREGROUND_POLL_ONLY"
            },
            "cleanupComplete": {
              "const": true
            },
            "cleanupScope": {
              "const": "APP_UNINSTALLED"
            },
            "deviceSessionId": {
              "type": "string",
              "format": "uuid"
            },
            "appIndex": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9
            }
          }
        },
        "openTimings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "totalMs", "steps"],
          "properties": {
            "version": {
              "const": 1
            },
            "totalMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3600000
            },
            "steps": {
              "type": "array",
              "maxItems": 12,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "startedMs", "elapsedMs", "outcome"],
                "properties": {
                  "name": {
                    "enum": [
                      "PROXY_CHECK",
                      "AVD_CREATE",
                      "EMULATOR_BOOT",
                      "DEVICE_CHECK",
                      "APK_VERIFY",
                      "APK_INSTALL",
                      "APP_LAUNCH",
                      "FOREGROUND_CHECK",
                      "FOREGROUND_DWELL",
                      "CLEANUP",
                      "STARTUP_ADS",
                      "APPIUM_PREPARE",
                      "IDENTITY_IMAGE_CHECK"
                    ]
                  },
                  "startedMs": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 3600000
                  },
                  "elapsedMs": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 3600000
                  },
                  "outcome": {
                    "enum": ["SUCCEEDED", "FAILED", "CANCELLED"]
                  }
                }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "SUCCEEDED"
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "proof": {
                "enum": ["APP_UI", "FILE_VALIDATION", "APP_OPEN"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "proof": {
                "const": "APP_UI"
              }
            },
            "required": ["proof"]
          },
          "then": {
            "required": ["accountRef"],
            "properties": {
              "artifactIds": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "errorCode": {
                "enum": ["NAVIGATION_SITE", "APP_NAVIGATION_ONLY"]
              }
            },
            "required": ["errorCode"]
          },
          "then": {
            "properties": {
              "status": {
                "const": "SKIPPED"
              },
              "proof": {
                "const": "NONE"
              }
            },
            "not": {
              "required": ["accountRef"]
            }
          }
        },
        {
          "if": {
            "properties": {
              "errorCode": {
                "const": "APP_AUTO_IDENTITY"
              }
            },
            "required": ["errorCode"]
          },
          "then": {
            "properties": {
              "status": {
                "const": "SKIPPED"
              },
              "proof": {
                "const": "NONE"
              },
              "recognition": {
                "required": ["automaticIdentity"],
                "type": "object"
              }
            },
            "required": ["recognition"],
            "not": {
              "required": ["accountRef"]
            }
          }
        },
        {
          "if": {
            "properties": {
              "proof": {
                "const": "APP_OPEN"
              }
            },
            "required": ["proof"]
          },
          "then": {
            "required": ["openObservation"],
            "properties": {
              "status": {
                "const": "SUCCEEDED"
              },
              "artifactIds": {
                "maxItems": 0,
                "type": "array"
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": ["accountRef"]
                },
                {
                  "required": ["recognition"]
                },
                {
                  "required": ["errorCode"]
                }
              ]
            }
          }
        },
        {
          "if": {
            "required": ["openObservation"]
          },
          "then": {
            "properties": {
              "proof": {
                "const": "APP_OPEN"
              }
            }
          }
        }
      ]
    },
    "runFinished": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "enum": ["SUCCEEDED", "PARTIAL_FAILED", "FAILED", "CANCELLED", "NEEDS_REVIEW"]
        },
        "errorCode": {
          "enum": [
            "NO_TARGETS",
            "TARGET_LIMIT",
            "DISCOVERY_FAILED",
            "NETWORK_BLOCKED",
            "DOWNLOAD_FAILED",
            "APK_INVALID",
            "APK_TOO_LARGE",
            "CLEANUP_INCOMPLETE",
            "REGISTRATION_UNKNOWN",
            "ANDROID_FAILED",
            "ACCOUNT_SYNC_FAILED",
            "ATTEMPT_LIMIT",
            "CACHE_MISSING",
            "NO_ADAPTED_APKS",
            "PROXY_CHECK_FAILED",
            "FLOW_LAYOUT_CHANGED",
            "AUTO_ADAPTATION_REQUIRED",
            "NO_APK_AVAILABLE",
            "NO_REGISTERABLE_APK",
            "DAY_CUTOFF"
          ]
        }
      }
    },
    "stopAck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cleanupComplete"],
      "properties": {
        "cleanupComplete": {
          "type": "boolean"
        }
      }
    },
    "log": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "message"],
      "properties": {
        "level": {
          "const": "INFO"
        },
        "message": {
          "enum": [
            "下载入口：已操作配置控件",
            "下载入口：已操作明确下载文字",
            "下载入口：正在访问源码中的唯一 APK 地址",
            "下载传输：已收到浏览器文件，等待保存与 APK 校验",
            "下载等待结束：未收到浏览器下载文件",
            "自有测试 APK：账户已上报",
            "自有测试 APK：中台已确认收到（APP响应未确认）",
            "自有测试 APK：上报结果尚未确认",
            "自有测试 APK：配置读取失败",
            "自有测试 APK：请求未获接受",
            "自有测试 APK：网络响应尚未确认"
          ]
        }
      }
    },
    "deviceObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profileId",
        "avdName",
        "apiLevel",
        "model",
        "locale",
        "shellAndroidIdHash",
        "androidIdScope",
        "proxyIpScope",
        "appUserAgent",
        "identitySource"
      ],
      "properties": {
        "profileId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "avdName": {
          "type": "string",
          "pattern": "^p3_[a-f0-9]{32}$"
        },
        "apiLevel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "model": {
          "type": "string",
          "maxLength": 200
        },
        "locale": {
          "type": "string",
          "maxLength": 100
        },
        "shellAndroidIdHash": {
          "$ref": "#/$defs/hash"
        },
        "androidIdScope": {
          "const": "SHELL_NOT_APP"
        },
        "proxyObservedIp": {
          "type": "string",
          "maxLength": 64
        },
        "proxyObservedAt": {
          "$ref": "#/$defs/time"
        },
        "proxyIpScope": {
          "enum": ["PROBE_ONLY", "NOT_CHECKED"]
        },
        "appUserAgent": {
          "const": "UNVERIFIED"
        },
        "identitySource": {
          "const": "EMULATOR_NOT_REAL_DEVICE"
        },
        "variantId": {
          "type": "string",
          "pattern": "^(qa-model-0[1-3]|phone-(0[1-9]|[12][0-9]|30))$"
        },
        "systemImageSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "deviceSessionId": {
          "type": "string",
          "format": "uuid"
        },
        "appIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "proxyIpScope": {
                "const": "PROBE_ONLY"
              }
            },
            "required": ["proxyIpScope"]
          },
          "then": {
            "required": ["proxyObservedIp", "proxyObservedAt"]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": ["proxyObservedIp"]
                },
                {
                  "required": ["proxyObservedAt"]
                }
              ]
            }
          }
        }
      ]
    },
    "proxyChecked": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "enum": ["SUCCEEDED", "FAILED"]
        },
        "ip": {
          "type": "string",
          "maxLength": 45
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "scope": {
          "const": "PROBE_ONLY"
        },
        "errorCode": {
          "const": "PROXY_CHECK_FAILED"
        }
      }
    },
    "browserEnvironment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "role": {
          "enum": ["SOURCE", "LANDING"]
        },
        "platform": {
          "const": "Android"
        },
        "mobile": {
          "const": true
        },
        "touch": {
          "const": true
        },
        "width": {
          "const": 412
        },
        "height": {
          "const": 915
        },
        "userAgent": {
          "type": "string",
          "minLength": 20,
          "maxLength": 1024,
          "pattern": "^[^\\r\\n]+$"
        },
        "scope": {
          "const": "EMULATED_BROWSER"
        }
      },
      "required": ["role", "platform", "mobile", "touch", "width", "height", "userAgent", "scope"]
    },
    "appObstruction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "SKIP_AD",
            "CLOSE_AD",
            "CLOSE_POPUP",
            "ACK_NOTICE",
            "WAIT_SPLASH",
            "WAIT_OVERLAY",
            "RETRY_LOAD"
          ]
        },
        "method": {
          "enum": ["CONTROLS", "OCR", "ICON", "BACK"]
        },
        "index": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "phase": {
          "enum": ["DETECTED", "WAITING", "ACTION_SENT", "CLEARED", "UNCHANGED", "UNVERIFIED"]
        }
      },
      "required": ["action", "method", "index"],
      "allOf": [
        {
          "if": {
            "properties": {
              "method": {
                "const": "ICON"
              }
            },
            "required": ["method"]
          },
          "then": {
            "required": ["phase"]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "WAIT_SPLASH"
              }
            },
            "required": ["action"]
          },
          "then": {
            "properties": {
              "phase": {
                "enum": ["DETECTED", "WAITING"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "WAIT_OVERLAY"
              }
            },
            "required": ["action"]
          },
          "then": {
            "required": ["phase"],
            "properties": {
              "method": {
                "const": "CONTROLS"
              },
              "phase": {
                "enum": ["DETECTED", "WAITING"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "BACK"
              }
            },
            "required": ["method"]
          },
          "then": {
            "required": ["phase"],
            "properties": {
              "action": {
                "const": "CLOSE_POPUP"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "RETRY_LOAD"
              }
            },
            "required": ["action"]
          },
          "then": {
            "required": ["phase"],
            "properties": {
              "method": {
                "const": "CONTROLS"
              }
            }
          }
        }
      ]
    },
    "deviceSession": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessionId", "phase", "elapsedMs", "cleanupComplete"],
      "properties": {
        "sessionId": {
          "type": "string",
          "format": "uuid"
        },
        "phase": {
          "enum": ["STARTED", "CLOSED", "FAILED"]
        },
        "elapsedMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600000
        },
        "cleanupComplete": {
          "type": "boolean"
        }
      }
    }
  }
}
