{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.apk-platform.example/v1/p1.schema.json",
  "$defs": {
    "NodeInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "host", "port", "username", "credentialVersionId"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9.:-]*$"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "username": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_-]{0,63}$"
        },
        "credentialVersionId": {
          "type": "string",
          "format": "uuid"
        },
        "sudoCredentialVersionId": {
          "type": ["string", "null"],
          "format": "uuid"
        }
      }
    },
    "SecretInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "secretValue"],
      "properties": {
        "type": {
          "enum": ["SSH_KEY", "SSH_PASSWORD", "SUDO_PASSWORD", "HTTP_PROXY"]
        },
        "secretValue": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "privateKey": {
              "type": "string",
              "minLength": 32,
              "maxLength": 65536
            },
            "passphrase": {
              "type": "string",
              "maxLength": 1024
            },
            "password": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "host": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9.:-]*$",
              "maxLength": 253
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "username": {
              "type": "string",
              "maxLength": 1024
            }
          }
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "SSH_KEY"
              }
            }
          },
          "then": {
            "properties": {
              "secretValue": {
                "required": ["privateKey"],
                "not": {
                  "anyOf": [
                    {
                      "required": ["password"]
                    },
                    {
                      "required": ["host"]
                    },
                    {
                      "required": ["port"]
                    },
                    {
                      "required": ["username"]
                    }
                  ]
                },
                "type": "object"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": ["SSH_PASSWORD", "SUDO_PASSWORD"]
              }
            }
          },
          "then": {
            "properties": {
              "secretValue": {
                "required": ["password"],
                "not": {
                  "anyOf": [
                    {
                      "required": ["privateKey"]
                    },
                    {
                      "required": ["passphrase"]
                    },
                    {
                      "required": ["host"]
                    },
                    {
                      "required": ["port"]
                    },
                    {
                      "required": ["username"]
                    }
                  ]
                },
                "type": "object"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "HTTP_PROXY"
              }
            }
          },
          "then": {
            "properties": {
              "secretValue": {
                "required": ["host", "port", "username", "password"],
                "not": {
                  "anyOf": [
                    {
                      "required": ["privateKey"]
                    },
                    {
                      "required": ["passphrase"]
                    }
                  ]
                },
                "type": "object"
              }
            }
          }
        }
      ]
    },
    "HostKeyInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["probeId", "expectedFingerprint"],
      "properties": {
        "probeId": {
          "type": "string",
          "format": "uuid"
        },
        "expectedFingerprint": {
          "type": "string",
          "pattern": "^SHA256:[A-Za-z0-9+/]{43}$"
        }
      }
    },
    "DeploymentInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeId", "releaseId", "licenseAccepted"],
      "properties": {
        "nodeId": {
          "type": "string",
          "format": "uuid"
        },
        "releaseId": {
          "type": "string",
          "format": "uuid"
        },
        "licenseAccepted": {
          "const": true
        }
      }
    },
    "ReasonInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason"],
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      }
    },
    "ReconcileInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkId", "reason"],
      "properties": {
        "checkId": {
          "type": "string",
          "format": "uuid"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      }
    },
    "ReleaseInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "gitCommit",
        "agentVersion",
        "protocolVersion",
        "artifactName",
        "sha256",
        "playbookSha256",
        "toolchain",
        "signature"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "gitCommit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "agentVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "protocolVersion": {
          "const": "1.0"
        },
        "artifactName": {
          "type": "string",
          "pattern": "^agent-[a-f0-9]{64}\\.tgz$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "playbookSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{86}==$"
        },
        "toolchain": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "nodeVersion",
            "nodeUrl",
            "nodeSha256",
            "playwrightVersion",
            "appiumVersion",
            "uiautomator2Version",
            "systemImage",
            "archives",
            "npmLockSha256"
          ],
          "properties": {
            "nodeVersion": {
              "const": "24.18.0"
            },
            "nodeUrl": {
              "const": "https://nodejs.org/dist/v24.18.0/node-v24.18.0-linux-x64.tar.xz"
            },
            "nodeSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "playwrightVersion": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            },
            "appiumVersion": {
              "type": "string",
              "pattern": "^3\\.[0-9]+\\.[0-9]+$"
            },
            "uiautomator2Version": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            },
            "systemImage": {
              "const": "system-images;android-35;google_apis;x86_64"
            },
            "archives": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["role", "url", "checksum", "revision"],
                "properties": {
                  "role": {
                    "enum": ["cmdlineTools", "emulator", "platformTools", "systemImage"]
                  },
                  "url": {
                    "type": "string",
                    "pattern": "^https://dl\\.google\\.com/android/repository/[A-Za-z0-9_./-]+\\.zip$",
                    "maxLength": 600
                  },
                  "checksum": {
                    "type": "string",
                    "pattern": "^(sha256:[a-f0-9]{64}|sha1:[a-f0-9]{40})$"
                  },
                  "revision": {
                    "type": "string",
                    "maxLength": 64,
                    "minLength": 1
                  }
                }
              }
            },
            "npmLockSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "extraSystemImages": {
              "type": "array",
              "minItems": 5,
              "maxItems": 5,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["role", "url", "checksum", "revision", "apiLevel"],
                "properties": {
                  "role": {
                    "const": "systemImage"
                  },
                  "url": {
                    "type": "string",
                    "pattern": "^https://dl\\.google\\.com/android/repository/[A-Za-z0-9_./-]+\\.zip$",
                    "maxLength": 600
                  },
                  "checksum": {
                    "type": "string",
                    "pattern": "^(sha256:[a-f0-9]{64}|sha1:[a-f0-9]{40})$"
                  },
                  "revision": {
                    "type": "string",
                    "maxLength": 64,
                    "minLength": 1
                  },
                  "apiLevel": {
                    "enum": [29, 31, 33, 34, 36]
                  }
                }
              }
            }
          }
        },
        "features": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "enum": [
              "DOWNLOAD_V1",
              "REGISTRATION_V1",
              "DAILY_V1",
              "AUTO_REGISTRATION_V1",
              "CONTENT_ISOLATION_V1",
              "APP_READINESS_V1",
              "APP_OPEN_V1",
              "APP_OPEN_PARALLEL_V1",
              "DEVICE_VARIANTS_V1",
              "OWNED_TEST_CLIENT_V1",
              "DEVICE_SESSIONS_V1"
            ]
          }
        }
      }
    },
    "HealthReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ubuntu",
        "arch",
        "memoryKiB",
        "freeDiskBytes",
        "kvm",
        "sudo",
        "markerPresent",
        "android",
        "download",
        "versions",
        "errors"
      ],
      "properties": {
        "ubuntu": {
          "type": "string",
          "maxLength": 32
        },
        "arch": {
          "type": "string",
          "maxLength": 32
        },
        "memoryKiB": {
          "type": "integer",
          "minimum": 0
        },
        "freeDiskBytes": {
          "type": "integer",
          "minimum": 0
        },
        "kvm": {
          "type": "boolean"
        },
        "sudo": {
          "type": "boolean"
        },
        "markerPresent": {
          "type": "boolean"
        },
        "android": {
          "type": "boolean"
        },
        "download": {
          "type": "boolean"
        },
        "versions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "node": {
              "type": "string",
              "maxLength": 100
            },
            "adb": {
              "type": "string",
              "maxLength": 100
            },
            "emulator": {
              "type": "string",
              "maxLength": 100
            },
            "appium": {
              "type": "string",
              "maxLength": 100
            },
            "playwright": {
              "type": "string",
              "maxLength": 100
            },
            "systemImage": {
              "type": "string",
              "maxLength": 100
            },
            "identityModels": {
              "type": "string",
              "pattern": "^([0-9]|[12][0-9]|30)$"
            },
            "identityCatalog": {
              "type": "string",
              "maxLength": 2000
            },
            "identityAbis": {
              "type": "string",
              "maxLength": 4000
            }
          }
        },
        "errors": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "enum": [
              "NO_KVM",
              "DISK_LOW",
              "UNSUPPORTED_OS",
              "UNSUPPORTED_ARCH",
              "SUDO_REQUIRED",
              "ANDROID_NOT_READY",
              "INSTALL_IN_PROGRESS"
            ]
          }
        }
      }
    },
    "NodeView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "host",
        "port",
        "username",
        "version",
        "credentialVersionId",
        "sudoCredentialVersionId",
        "expectedFingerprint",
        "deploymentStatus",
        "connection",
        "occupancy",
        "lastSeenAt",
        "agentVersion",
        "agentReleaseId",
        "health",
        "createdAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer"
        },
        "username": {
          "type": "string"
        },
        "version": {
          "type": "integer"
        },
        "credentialVersionId": {
          "type": ["string", "null"]
        },
        "sudoCredentialVersionId": {
          "type": ["string", "null"]
        },
        "expectedFingerprint": {
          "type": ["string", "null"]
        },
        "deploymentStatus": {
          "type": "string"
        },
        "connection": {
          "enum": ["ONLINE", "OFFLINE"]
        },
        "occupancy": {
          "enum": ["IDLE", "BUSY", "QUARANTINED"]
        },
        "lastSeenAt": {
          "type": ["string", "null"]
        },
        "agentVersion": {
          "type": ["string", "null"]
        },
        "agentReleaseId": {
          "type": ["string", "null"]
        },
        "health": {
          "type": ["object", "null"]
        },
        "createdAt": {
          "type": "string"
        },
        "downloadProtocol": {
          "type": ["string", "null"],
          "enum": ["1.0", null]
        },
        "registrationProtocol": {
          "type": ["string", "null"]
        }
      }
    },
    "ExecutionOS": {
      "type": "object",
      "additionalProperties": false,
      "required": ["distribution", "version"],
      "properties": {
        "distribution": {
          "const": "ubuntu"
        },
        "version": {
          "enum": ["24.04", "26.04"]
        }
      }
    }
  }
}
