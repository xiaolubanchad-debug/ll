{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.apk-platform.example/v1/p1.schema.json",
  "$defs": {
    "NodeInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "host",
        "port",
        "username",
        "credentialVersionId"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9.:-]*$"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "username": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_-]{0,63}$"
        },
        "credentialVersionId": {
          "type": "string",
          "format": "uuid"
        },
        "sudoCredentialVersionId": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        }
      }
    },
    "SecretInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "secretValue"
      ],
      "properties": {
        "type": {
          "enum": [
            "SSH_KEY",
            "SSH_PASSWORD",
            "SUDO_PASSWORD",
            "HTTP_PROXY"
          ]
        },
        "secretValue": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "privateKey": {
              "type": "string",
              "minLength": 32,
              "maxLength": 65536
            },
            "passphrase": {
              "type": "string",
              "maxLength": 1024
            },
            "password": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "host": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9.:-]*$",
              "maxLength": 253
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "username": {
              "type": "string",
              "maxLength": 1024
            }
          }
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "SSH_KEY"
              }
            }
          },
          "then": {
            "properties": {
              "secretValue": {
                "required": [
                  "privateKey"
                ],
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "password"
                      ]
                    },
                    {
                      "required": [
                        "host"
                      ]
                    },
                    {
                      "required": [
                        "port"
                      ]
                    },
                    {
                      "required": [
                        "username"
                      ]
                    }
                  ]
                },
                "type": "object"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "SSH_PASSWORD",
                  "SUDO_PASSWORD"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "secretValue": {
                "required": [
                  "password"
                ],
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "privateKey"
                      ]
                    },
                    {
                      "required": [
                        "passphrase"
                      ]
                    },
                    {
                      "required": [
                        "host"
                      ]
                    },
                    {
                      "required": [
                        "port"
                      ]
                    },
                    {
                      "required": [
                        "username"
                      ]
                    }
                  ]
                },
                "type": "object"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "HTTP_PROXY"
              }
            }
          },
          "then": {
            "properties": {
              "secretValue": {
                "required": [
                  "host",
                  "port",
                  "username",
                  "password"
                ],
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "privateKey"
                      ]
                    },
                    {
                      "required": [
                        "passphrase"
                      ]
                    }
                  ]
                },
                "type": "object"
              }
            }
          }
        }
      ]
    },
    "HostKeyInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "probeId",
        "expectedFingerprint"
      ],
      "properties": {
        "probeId": {
          "type": "string",
          "format": "uuid"
        },
        "expectedFingerprint": {
          "type": "string",
          "pattern": "^SHA256:[A-Za-z0-9+/]{43}$"
        }
      }
    },
    "DeploymentInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeId",
        "releaseId",
        "licenseAccepted"
      ],
      "properties": {
        "nodeId": {
          "type": "string",
          "format": "uuid"
        },
        "releaseId": {
          "type": "string",
          "format": "uuid"
        },
        "licenseAccepted": {
          "const": true
        },
        "mode": {
          "enum": [
            "AUTO",
            "FULL"
          ]
        }
      }
    },
    "ReasonInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason"
      ],
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      }
    },
    "ReconcileInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkId",
        "reason"
      ],
      "properties": {
        "checkId": {
          "type": "string",
          "format": "uuid"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      }
    },
    "ReleaseInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "gitCommit",
        "agentVersion",
        "protocolVersion",
        "artifactName",
        "sha256",
        "playbookSha256",
        "toolchain",
        "signature"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "gitCommit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "agentVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "protocolVersion": {
          "const": "1.0"
        },
        "artifactName": {
          "type": "string",
          "pattern": "^agent-[a-f0-9]{64}\\.tgz$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "playbookSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{86}==$"
        },
        "toolchain": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "nodeVersion",
            "nodeUrl",
            "nodeSha256",
            "playwrightVersion",
            "appiumVersion",
            "uiautomator2Version",
            "systemImage",
            "archives",
            "npmLockSha256"
          ],
          "properties": {
            "nodeVersion": {
              "const": "24.18.0"
            },
            "nodeUrl": {
              "const": "https://nodejs.org/dist/v24.18.0/node-v24.18.0-linux-x64.tar.xz"
            },
            "nodeSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "playwrightVersion": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            },
            "appiumVersion": {
              "type": "string",
              "pattern": "^3\\.[0-9]+\\.[0-9]+$"
            },
            "uiautomator2Version": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            },
            "systemImage": {
              "const": "system-images;android-35;google_apis;x86_64"
            },
            "archives": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "role",
                  "url",
                  "checksum",
                  "revision"
                ],
                "properties": {
                  "role": {
                    "enum": [
                      "cmdlineTools",
                      "emulator",
                      "platformTools",
                      "systemImage"
                    ]
                  },
                  "url": {
                    "type": "string",
                    "pattern": "^https://dl\\.google\\.com/android/repository/[A-Za-z0-9_./-]+\\.zip$",
                    "maxLength": 600
                  },
                  "checksum": {
                    "type": "string",
                    "pattern": "^(sha256:[a-f0-9]{64}|sha1:[a-f0-9]{40})$"
                  },
                  "revision": {
                    "type": "string",
                    "maxLength": 64,
                    "minLength": 1
                  }
                }
              }
            },
            "npmLockSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "extraSystemImages": {
              "type": "array",
              "minItems": 5,
              "maxItems": 5,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "role",
                  "url",
                  "checksum",
                  "revision",
                  "apiLevel"
                ],
                "properties": {
                  "role": {
                    "const": "systemImage"
                  },
                  "url": {
                    "type": "string",
                    "pattern": "^https://dl\\.google\\.com/android/repository/[A-Za-z0-9_./-]+\\.zip$",
                    "maxLength": 600
                  },
                  "checksum": {
                    "type": "string",
                    "pattern": "^(sha256:[a-f0-9]{64}|sha1:[a-f0-9]{40})$"
                  },
                  "revision": {
                    "type": "string",
                    "maxLength": 64,
                    "minLength": 1
                  },
                  "apiLevel": {
                    "enum": [
                      29,
                      31,
                      33,
                      34,
                      36
                    ]
                  }
                }
              }
            }
          }
        },
        "features": {
          "type": "array",
          "maxItems": 17,
          "uniqueItems": true,
          "items": {
            "enum": [
              "DOWNLOAD_V1",
              "REGISTRATION_V1",
              "DAILY_V1",
              "AUTO_REGISTRATION_V1",
              "CONTENT_ISOLATION_V1",
              "APP_READINESS_V1",
              "APP_OPEN_V1",
              "APP_OPEN_PARALLEL_V1",
              "DEVICE_VARIANTS_V1",
              "OWNED_TEST_CLIENT_V1",
              "DEVICE_SESSIONS_V1",
              "EXECUTION_CAPACITY_V1",
              "INCREMENTAL_DEPLOY_V1",
              "MANUAL_APK_IMPORT_V1",
              "APK_METADATA_ONLY_V1",
              "APK_FILE_ASSETS_V1",
              "XPATH_OBSERVATION_V1"
            ]
          }
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "recipeSha256",
            "fingerprint"
          ],
          "properties": {
            "version": {
              "const": 1
            },
            "recipeSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "fingerprint": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      }
    },
    "HealthReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ubuntu",
        "arch",
        "memoryKiB",
        "freeDiskBytes",
        "kvm",
        "sudo",
        "markerPresent",
        "android",
        "download",
        "versions",
        "errors"
      ],
      "properties": {
        "ubuntu": {
          "type": "string",
          "maxLength": 32
        },
        "arch": {
          "type": "string",
          "maxLength": 32
        },
        "memoryKiB": {
          "type": "integer",
          "minimum": 0
        },
        "freeDiskBytes": {
          "type": "integer",
          "minimum": 0
        },
        "kvm": {
          "type": "boolean"
        },
        "sudo": {
          "type": "boolean"
        },
        "markerPresent": {
          "type": "boolean"
        },
        "android": {
          "type": "boolean"
        },
        "download": {
          "type": "boolean"
        },
        "versions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "node": {
              "type": "string",
              "maxLength": 100
            },
            "adb": {
              "type": "string",
              "maxLength": 100
            },
            "emulator": {
              "type": "string",
              "maxLength": 100
            },
            "appium": {
              "type": "string",
              "maxLength": 100
            },
            "playwright": {
              "type": "string",
              "maxLength": 100
            },
            "systemImage": {
              "type": "string",
              "maxLength": 100
            },
            "identityModels": {
              "type": "string",
              "pattern": "^([0-9]|[12][0-9]|30)$"
            },
            "identityCatalog": {
              "type": "string",
              "maxLength": 2000
            },
            "identityAbis": {
              "type": "string",
              "maxLength": 4000
            },
            "buildCommit": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "environmentFingerprint": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "environmentValidation": {
              "enum": [
                "FULL",
                "CODE"
              ]
            },
            "environmentFullRelease": {
              "type": "string",
              "format": "uuid"
            },
            "environmentFullVerifiedAt": {
              "type": "string",
              "format": "date-time"
            },
            "environmentBaselineVersion": {
              "const": "1"
            }
          }
        },
        "errors": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "enum": [
              "NO_KVM",
              "DISK_LOW",
              "UNSUPPORTED_OS",
              "UNSUPPORTED_ARCH",
              "SUDO_REQUIRED",
              "ANDROID_NOT_READY",
              "INSTALL_IN_PROGRESS"
            ]
          }
        }
      }
    },
    "NodeView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "host",
        "port",
        "username",
        "version",
        "credentialVersionId",
        "sudoCredentialVersionId",
        "expectedFingerprint",
        "deploymentStatus",
        "connection",
        "occupancy",
        "lastSeenAt",
        "agentVersion",
        "agentReleaseId",
        "health",
        "createdAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer"
        },
        "username": {
          "type": "string"
        },
        "version": {
          "type": "integer"
        },
        "credentialVersionId": {
          "type": [
            "string",
            "null"
          ]
        },
        "sudoCredentialVersionId": {
          "type": [
            "string",
            "null"
          ]
        },
        "expectedFingerprint": {
          "type": [
            "string",
            "null"
          ]
        },
        "deploymentStatus": {
          "type": "string"
        },
        "connection": {
          "enum": [
            "ONLINE",
            "OFFLINE"
          ]
        },
        "occupancy": {
          "enum": [
            "IDLE",
            "BUSY",
            "QUARANTINED"
          ]
        },
        "lastSeenAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "agentVersion": {
          "type": [
            "string",
            "null"
          ]
        },
        "agentReleaseId": {
          "type": [
            "string",
            "null"
          ]
        },
        "health": {
          "type": [
            "object",
            "null"
          ]
        },
        "createdAt": {
          "type": "string"
        },
        "downloadProtocol": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "1.0",
            null
          ]
        },
        "registrationProtocol": {
          "type": [
            "string",
            "null"
          ]
        },
        "activeRunId": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "activeOperationId": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "activeStopRequested": {
          "type": "boolean"
        }
      }
    },
    "ExecutionOS": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "distribution",
        "version"
      ],
      "properties": {
        "distribution": {
          "const": "ubuntu"
        },
        "version": {
          "enum": [
            "24.04",
            "26.04"
          ]
        }
      }
    },
    "NodeCapacityQuery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "appsPerDeviceMin": {
          "type": "string",
          "pattern": "^(?:[1-9]|[1-9][0-9]{1,2}|1000)$"
        }
      },
      "required": []
    },
    "NodeCapacityInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dailyLimit"
      ],
      "properties": {
        "dailyLimit": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 8640
        }
      }
    },
    "NodeCapacityView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeId",
        "version",
        "day",
        "supported",
        "mode",
        "manualLimit",
        "recommendedLimit",
        "limit",
        "used",
        "remaining",
        "frozen",
        "sampleRuns",
        "sampleApps",
        "sampleScope",
        "deviceSetupMs",
        "appMs",
        "appsPerDeviceMin",
        "reservePercent",
        "remainingTimeEstimate",
        "admissionDeadline"
      ],
      "properties": {
        "nodeId": {
          "type": "string",
          "format": "uuid"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "day": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "supported": {
          "type": "boolean"
        },
        "mode": {
          "enum": [
            "AUTO",
            "MANUAL"
          ]
        },
        "manualLimit": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 8640
        },
        "recommendedLimit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8640
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8640
        },
        "used": {
          "type": "integer",
          "minimum": 0
        },
        "remaining": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8640
        },
        "frozen": {
          "type": "boolean"
        },
        "sampleRuns": {
          "type": "integer",
          "minimum": 0
        },
        "sampleApps": {
          "type": "integer",
          "minimum": 0
        },
        "sampleScope": {
          "enum": [
            "OWNED_TEST_ONLY",
            "NODE_HISTORY",
            "CONSERVATIVE_REFERENCE"
          ]
        },
        "deviceSetupMs": {
          "type": "integer",
          "minimum": 0
        },
        "appMs": {
          "type": "integer",
          "minimum": 10000
        },
        "appsPerDeviceMin": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "reservePercent": {
          "const": 25
        },
        "remainingTimeEstimate": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8640
        },
        "admissionDeadline": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "EnvironmentSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "recipeSha256",
        "fingerprint"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "recipeSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "DeploymentOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "reason",
        "environmentFingerprint"
      ],
      "properties": {
        "mode": {
          "enum": [
            "CODE",
            "FULL"
          ]
        },
        "reason": {
          "enum": [
            "BASELINE_VALID",
            "BASELINE_MISSING",
            "BASELINE_INVALID",
            "ENVIRONMENT_CHANGED",
            "FORCED_FULL",
            "RUNTIME_MISSING"
          ]
        },
        "environmentFingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "EnvironmentInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeId",
        "releaseId",
        "environmentFingerprint",
        "sdkRoot",
        "toolsRoot"
      ],
      "properties": {
        "nodeId": {
          "type": "string",
          "format": "uuid"
        },
        "releaseId": {
          "type": "string",
          "format": "uuid"
        },
        "environmentFingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sdkRoot": {
          "type": "string",
          "pattern": "^/opt/apk-platform/toolchains/[a-f0-9]{64}/android$"
        },
        "toolsRoot": {
          "type": "string",
          "pattern": "^/opt/apk-platform/toolchains/[a-f0-9]{64}/tools$"
        }
      }
    },
    "EnvironmentHealth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "releaseId",
        "mode",
        "environmentFingerprint",
        "fullReleaseId",
        "fullVerifiedAt"
      ],
      "properties": {
        "version": {
          "const": 2
        },
        "releaseId": {
          "type": "string",
          "format": "uuid"
        },
        "mode": {
          "enum": [
            "CODE",
            "FULL"
          ]
        },
        "environmentFingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
