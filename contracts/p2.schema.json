{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.apk-platform.example/v1/p2.schema.json",
  "$defs": {
    "ConfigInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      }
    },
    "RunInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeId", "configVersionId", "releaseId"],
      "properties": {
        "nodeId": {
          "type": "string",
          "format": "uuid"
        },
        "configVersionId": {
          "type": "string",
          "format": "uuid"
        },
        "releaseId": {
          "type": "string",
          "format": "uuid"
        },
        "supersedesRunId": {
          "type": "string",
          "format": "uuid"
        },
        "purpose": {
          "enum": ["DOWNLOAD", "REGISTER", "PROXY_CHECK"]
        },
        "sourceDownloadId": {
          "type": "string",
          "format": "uuid"
        },
        "successTarget": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "attemptLimit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "proxySecretVersionId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "purpose": {
                "const": "REGISTER"
              }
            },
            "required": ["purpose"]
          },
          "then": {
            "required": ["sourceDownloadId", "successTarget", "attemptLimit"]
          }
        },
        {
          "if": {
            "properties": {
              "purpose": {
                "const": "PROXY_CHECK"
              }
            },
            "required": ["purpose"]
          },
          "then": {
            "required": ["proxySecretVersionId"]
          }
        }
      ]
    },
    "RunReconcileInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason"],
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      }
    },
    "AgentReconcileInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "nodeId", "bootId", "deliveries", "cleanupComplete"],
      "properties": {
        "protocolVersion": {
          "const": "1.0"
        },
        "nodeId": {
          "type": "string",
          "format": "uuid"
        },
        "bootId": {
          "type": "string",
          "format": "uuid"
        },
        "deliveries": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["deliveryId", "fence", "cleanupComplete"],
            "properties": {
              "deliveryId": {
                "type": "string",
                "format": "uuid"
              },
              "fence": {
                "type": "integer",
                "minimum": 1
              },
              "cleanupComplete": {
                "type": "boolean"
              },
              "submissions": {
                "type": "array",
                "maxItems": 1000,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["taskId", "submissionId", "accountRef"],
                  "properties": {
                    "taskId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "submissionId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "accountRef": {
                      "type": "string",
                      "format": "uuid"
                    }
                  }
                }
              }
            }
          }
        },
        "cleanupComplete": {
          "type": "boolean"
        }
      }
    },
    "DeliveryConfigInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "nodeId", "bootId", "deliveryId", "fence"],
      "properties": {
        "protocolVersion": {
          "const": "1.0"
        },
        "nodeId": {
          "type": "string",
          "format": "uuid"
        },
        "bootId": {
          "type": "string",
          "format": "uuid"
        },
        "deliveryId": {
          "type": "string",
          "format": "uuid"
        },
        "fence": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "ApkMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packageName",
        "versionName",
        "versionCode",
        "abis",
        "size",
        "apkSha256",
        "cacheDay"
      ],
      "properties": {
        "packageName": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_]*(\\.[a-zA-Z][a-zA-Z0-9_]*)+$",
          "maxLength": 256
        },
        "versionName": {
          "type": ["string", "null"],
          "maxLength": 256
        },
        "versionCode": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "abis": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 20,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,40}$"
          }
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 536870912
        },
        "apkSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "cacheDay": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "minSdkVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      }
    }
  }
}
