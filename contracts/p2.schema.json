{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.apk-platform.example/v1/p2.schema.json",
  "$defs": {
    "ConfigInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      }
    },
    "RunInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeId",
        "configVersionId",
        "releaseId"
      ],
      "properties": {
        "nodeId": {
          "type": "string",
          "format": "uuid"
        },
        "configVersionId": {
          "type": "string",
          "format": "uuid"
        },
        "releaseId": {
          "type": "string",
          "format": "uuid"
        },
        "supersedesRunId": {
          "type": "string",
          "format": "uuid"
        },
        "purpose": {
          "enum": [
            "DOWNLOAD",
            "REGISTER",
            "PROXY_CHECK"
          ]
        },
        "sourceDownloadId": {
          "type": "string",
          "format": "uuid"
        },
        "successTarget": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8640
        },
        "attemptLimit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8640
        },
        "proxySecretVersionId": {
          "type": "string",
          "format": "uuid"
        },
        "resourceAction": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "SCAN"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "targetKey",
                "url"
              ],
              "properties": {
                "kind": {
                  "const": "FETCH"
                },
                "targetKey": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "url": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https?://",
                  "maxLength": 4096
                }
              }
            }
          ]
        },
        "resourceAssets": {
          "const": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "purpose": {
                "const": "REGISTER"
              }
            },
            "required": [
              "purpose"
            ]
          },
          "then": {
            "required": [
              "successTarget",
              "attemptLimit"
            ],
            "allOf": [
              {
                "if": {
                  "not": {
                    "required": [
                      "resourceAssets"
                    ]
                  }
                },
                "then": {
                  "required": [
                    "sourceDownloadId"
                  ]
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "purpose": {
                "const": "PROXY_CHECK"
              }
            },
            "required": [
              "purpose"
            ]
          },
          "then": {
            "required": [
              "proxySecretVersionId"
            ]
          }
        }
      ]
    },
    "RunReconcileInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason"
      ],
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      }
    },
    "AgentReconcileInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "nodeId",
        "bootId",
        "deliveries",
        "cleanupComplete"
      ],
      "properties": {
        "protocolVersion": {
          "const": "1.0"
        },
        "nodeId": {
          "type": "string",
          "format": "uuid"
        },
        "bootId": {
          "type": "string",
          "format": "uuid"
        },
        "deliveries": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "deliveryId",
              "fence",
              "cleanupComplete"
            ],
            "properties": {
              "deliveryId": {
                "type": "string",
                "format": "uuid"
              },
              "fence": {
                "type": "integer",
                "minimum": 1
              },
              "cleanupComplete": {
                "type": "boolean"
              },
              "submissions": {
                "type": "array",
                "maxItems": 1000,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "taskId",
                    "submissionId",
                    "accountRef"
                  ],
                  "properties": {
                    "taskId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "submissionId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "accountRef": {
                      "type": "string",
                      "format": "uuid"
                    }
                  }
                }
              }
            }
          }
        },
        "cleanupComplete": {
          "type": "boolean"
        },
        "reason": {
          "enum": [
            "STARTUP",
            "EXECUTION_ERROR",
            "STOP_RECOVERY"
          ]
        }
      }
    },
    "DeliveryConfigInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "nodeId",
        "bootId",
        "deliveryId",
        "fence"
      ],
      "properties": {
        "protocolVersion": {
          "const": "1.0"
        },
        "nodeId": {
          "type": "string",
          "format": "uuid"
        },
        "bootId": {
          "type": "string",
          "format": "uuid"
        },
        "deliveryId": {
          "type": "string",
          "format": "uuid"
        },
        "fence": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "ApkMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "versionName",
        "versionCode",
        "abis",
        "size",
        "apkSha256",
        "cacheDay"
      ],
      "properties": {
        "packageName": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_]*(\\.[a-zA-Z][a-zA-Z0-9_]*)+$",
          "maxLength": 256
        },
        "versionName": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "versionCode": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "abis": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 20,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,40}$"
          }
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 536870912
        },
        "apkSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "cacheDay": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "minSdkVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "validationPolicy": {
          "enum": [
            "ANDROID_INSTALL",
            "FILE_NAME"
          ]
        },
        "fileName": {
          "type": "string",
          "minLength": 5,
          "maxLength": 200,
          "pattern": "^[^\\\\/\\u0000-\\u001f\\u007f]+\\.apk$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "validationPolicy": {
                "const": "FILE_NAME"
              }
            },
            "required": [
              "validationPolicy"
            ]
          },
          "then": {
            "required": [
              "fileName"
            ]
          },
          "else": {
            "required": [
              "packageName"
            ]
          }
        }
      ]
    },
    "SourceElement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "position",
        "tag",
        "scope",
        "attributes",
        "label"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "position": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "tag": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "scope": {
          "enum": [
            "ATTRIBUTE",
            "POSITION"
          ]
        },
        "attributes": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "value"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_.:-]{0,63}$"
              },
              "value": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            }
          }
        },
        "label": {
          "type": "string",
          "maxLength": 200
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "scope": {
                "const": "ATTRIBUTE"
              }
            }
          },
          "then": {
            "properties": {
              "attributes": {
                "type": "array",
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "attributes": {
                "type": "array",
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "SourceElementCheck": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "label",
            "kind",
            "attribute",
            "value"
          ],
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "kind": {
              "const": "ATTRIBUTE"
            },
            "attribute": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_.:-]{0,63}$"
            },
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "label",
            "kind",
            "tag"
          ],
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "kind": {
              "const": "TAG"
            },
            "tag": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "label",
            "kind",
            "xpath"
          ],
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "kind": {
              "const": "XPATH"
            },
            "xpath": {
              "type": "string",
              "minLength": 1,
              "maxLength": 12000
            }
          }
        }
      ]
    },
    "SourceElementIssue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "reason"
      ],
      "properties": {
        "scope": {
          "enum": [
            "DISCOVERY",
            "CLICK"
          ]
        },
        "reason": {
          "enum": [
            "NOT_FOUND",
            "NOT_VISIBLE",
            "NOT_UNIQUE",
            "CHANGED",
            "NO_MATCHES",
            "READ_FAILED"
          ]
        },
        "element": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "key",
            "position",
            "tag",
            "scope",
            "attributes",
            "label"
          ],
          "properties": {
            "key": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "position": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            },
            "tag": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,63}$"
            },
            "scope": {
              "enum": [
                "ATTRIBUTE",
                "POSITION"
              ]
            },
            "attributes": {
              "type": "array",
              "maxItems": 3,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "value"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^[A-Za-z_][A-Za-z0-9_.:-]{0,63}$"
                  },
                  "value": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                }
              }
            },
            "label": {
              "type": "string",
              "maxLength": 200
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "scope": {
                    "const": "ATTRIBUTE"
                  }
                }
              },
              "then": {
                "properties": {
                  "attributes": {
                    "type": "array",
                    "minItems": 1
                  }
                }
              },
              "else": {
                "properties": {
                  "attributes": {
                    "type": "array",
                    "maxItems": 0
                  }
                }
              }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "scope": {
                "const": "CLICK"
              }
            }
          },
          "then": {
            "required": [
              "element"
            ],
            "properties": {
              "reason": {
                "enum": [
                  "NOT_FOUND",
                  "NOT_VISIBLE",
                  "NOT_UNIQUE",
                  "CHANGED"
                ]
              }
            }
          },
          "else": {
            "properties": {
              "reason": {
                "enum": [
                  "NO_MATCHES",
                  "READ_FAILED"
                ]
              }
            }
          }
        }
      ]
    },
    "SourceElementObservation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "phase",
            "ruleId",
            "status",
            "matchedCount"
          ],
          "properties": {
            "phase": {
              "const": "CHECK"
            },
            "ruleId": {
              "type": "string",
              "format": "uuid"
            },
            "status": {
              "enum": [
                "FOUND",
                "NOT_FOUND",
                "READ_FAILED"
              ]
            },
            "matchedCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope",
            "reason",
            "phase"
          ],
          "properties": {
            "scope": {
              "enum": [
                "DISCOVERY",
                "CLICK"
              ]
            },
            "reason": {
              "enum": [
                "NOT_FOUND",
                "NOT_VISIBLE",
                "NOT_UNIQUE",
                "CHANGED",
                "NO_MATCHES",
                "READ_FAILED"
              ]
            },
            "element": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "key",
                "position",
                "tag",
                "scope",
                "attributes",
                "label"
              ],
              "properties": {
                "key": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "position": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100000
                },
                "tag": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                },
                "scope": {
                  "enum": [
                    "ATTRIBUTE",
                    "POSITION"
                  ]
                },
                "attributes": {
                  "type": "array",
                  "maxItems": 3,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "name",
                      "value"
                    ],
                    "properties": {
                      "name": {
                        "type": "string",
                        "pattern": "^[A-Za-z_][A-Za-z0-9_.:-]{0,63}$"
                      },
                      "value": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      }
                    }
                  }
                },
                "label": {
                  "type": "string",
                  "maxLength": 200
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "scope": {
                        "const": "ATTRIBUTE"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "attributes": {
                        "type": "array",
                        "minItems": 1
                      }
                    }
                  },
                  "else": {
                    "properties": {
                      "attributes": {
                        "type": "array",
                        "maxItems": 0
                      }
                    }
                  }
                }
              ]
            },
            "phase": {
              "const": "ISSUE"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "scope": {
                    "const": "CLICK"
                  }
                }
              },
              "then": {
                "required": [
                  "element"
                ],
                "properties": {
                  "reason": {
                    "enum": [
                      "NOT_FOUND",
                      "NOT_VISIBLE",
                      "NOT_UNIQUE",
                      "CHANGED"
                    ]
                  }
                }
              },
              "else": {
                "properties": {
                  "reason": {
                    "enum": [
                      "NO_MATCHES",
                      "READ_FAILED"
                    ]
                  }
                }
              }
            }
          ]
        }
      ]
    },
    "SourceElementSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "xpath",
        "checks",
        "totalIssues",
        "issues"
      ],
      "properties": {
        "xpath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "checks": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "xpath",
              "status",
              "matchedCount",
              "occurredAt"
            ],
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "xpath": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000
              },
              "status": {
                "enum": [
                  "PENDING",
                  "FOUND",
                  "NOT_FOUND",
                  "READ_FAILED"
                ]
              },
              "matchedCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2147483647
              },
              "occurredAt": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              }
            }
          }
        },
        "totalIssues": {
          "type": "integer",
          "minimum": 0
        },
        "issues": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "scope",
              "reason",
              "occurredAt"
            ],
            "properties": {
              "scope": {
                "enum": [
                  "DISCOVERY",
                  "CLICK"
                ]
              },
              "reason": {
                "enum": [
                  "NOT_FOUND",
                  "NOT_VISIBLE",
                  "NOT_UNIQUE",
                  "CHANGED",
                  "NO_MATCHES",
                  "READ_FAILED"
                ]
              },
              "element": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "key",
                  "position",
                  "tag",
                  "scope",
                  "attributes",
                  "label"
                ],
                "properties": {
                  "key": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "position": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100000
                  },
                  "tag": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                  },
                  "scope": {
                    "enum": [
                      "ATTRIBUTE",
                      "POSITION"
                    ]
                  },
                  "attributes": {
                    "type": "array",
                    "maxItems": 3,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "name",
                        "value"
                      ],
                      "properties": {
                        "name": {
                          "type": "string",
                          "pattern": "^[A-Za-z_][A-Za-z0-9_.:-]{0,63}$"
                        },
                        "value": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 200
                        }
                      }
                    }
                  },
                  "label": {
                    "type": "string",
                    "maxLength": 200
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "scope": {
                          "const": "ATTRIBUTE"
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "attributes": {
                          "type": "array",
                          "minItems": 1
                        }
                      }
                    },
                    "else": {
                      "properties": {
                        "attributes": {
                          "type": "array",
                          "maxItems": 0
                        }
                      }
                    }
                  }
                ]
              },
              "occurredAt": {
                "type": "string",
                "format": "date-time"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "scope": {
                      "const": "CLICK"
                    }
                  }
                },
                "then": {
                  "required": [
                    "element"
                  ],
                  "properties": {
                    "reason": {
                      "enum": [
                        "NOT_FOUND",
                        "NOT_VISIBLE",
                        "NOT_UNIQUE",
                        "CHANGED"
                      ]
                    }
                  }
                },
                "else": {
                  "properties": {
                    "reason": {
                      "enum": [
                        "NO_MATCHES",
                        "READ_FAILED"
                      ]
                    }
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
