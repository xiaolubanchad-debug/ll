{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.apk-platform.example/v1/p3.schema.json",
  "$defs": {
    "ArtifactInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "nodeId",
        "bootId",
        "deliveryId",
        "fence",
        "taskId",
        "artifactId",
        "kind",
        "sha256",
        "dataBase64",
        "redaction"
      ],
      "properties": {
        "protocolVersion": {
          "const": "1.0"
        },
        "nodeId": {
          "type": "string",
          "format": "uuid"
        },
        "bootId": {
          "type": "string",
          "format": "uuid"
        },
        "deliveryId": {
          "type": "string",
          "format": "uuid"
        },
        "fence": {
          "type": "integer",
          "minimum": 1
        },
        "taskId": {
          "type": "string",
          "format": "uuid"
        },
        "artifactId": {
          "type": "string",
          "format": "uuid"
        },
        "kind": {
          "const": "functional-evidence"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "dataBase64": {
          "type": "string",
          "minLength": 8,
          "maxLength": 87384,
          "pattern": "^[A-Za-z0-9+/]+={0,2}$"
        },
        "redaction": {
          "const": "CONTENT_ISOLATED"
        }
      }
    },
    "AccountViewInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason"
      ],
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      }
    },
    "TaskReconcileInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "reason",
        "evidenceIds"
      ],
      "properties": {
        "outcome": {
          "enum": [
            "SUCCEEDED",
            "FAILED"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 10,
          "maxLength": 1000
        },
        "evidenceIds": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    },
    "FunctionalEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "stage",
        "outcome",
        "verification",
        "sourceDigest",
        "controls"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0"
        },
        "kind": {
          "const": "FUNCTIONAL_EVIDENCE"
        },
        "stage": {
          "enum": [
            "RESULT",
            "DISCOVERY"
          ]
        },
        "outcome": {
          "enum": [
            "SUCCEEDED",
            "FAILED",
            "UNVERIFIED"
          ]
        },
        "verification": {
          "enum": [
            "AUTO_EXPLICIT_UI",
            "CONFIGURED_LOCATOR",
            "NO_SUBMISSION"
          ]
        },
        "sourceDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "controls": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role",
              "rect"
            ],
            "properties": {
              "role": {
                "enum": [
                  "USERNAME",
                  "PASSWORD",
                  "PASSWORD_CONFIRM",
                  "REGISTER",
                  "LOGIN",
                  "ACCOUNT",
                  "CONSENT",
                  "RESULT"
                ]
              },
              "rect": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "x",
                  "y",
                  "width",
                  "height"
                ],
                "properties": {
                  "x": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 16384
                  },
                  "y": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 16384
                  },
                  "width": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 16384
                  },
                  "height": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 16384
                  }
                }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "stage": {
                "const": "DISCOVERY"
              }
            }
          },
          "then": {
            "properties": {
              "outcome": {
                "const": "UNVERIFIED"
              },
              "verification": {
                "const": "NO_SUBMISSION"
              }
            }
          },
          "else": {
            "properties": {
              "outcome": {
                "enum": [
                  "SUCCEEDED",
                  "FAILED"
                ]
              },
              "verification": {
                "enum": [
                  "AUTO_EXPLICIT_UI",
                  "CONFIGURED_LOCATOR"
                ]
              }
            }
          }
        }
      ]
    }
  }
}
