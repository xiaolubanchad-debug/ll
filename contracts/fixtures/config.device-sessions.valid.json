{
  "schemaVersion": "1.0",
  "name": "自有多 APP 设备会话示例",
  "source": {
    "url": "https://control.example.test/api/v1/test-client?suite=1",
    "xpath": "//a[@class='test-apk']",
    "browserUserAgent": ""
  },
  "download": {
    "cacheTimezone": "Asia/Shanghai",
    "maxTargets": 100,
    "maxLandingClicks": 3,
    "timeoutMs": 90000,
    "retries": 2,
    "landingRules": [
      {
        "host": "*",
        "by": "css",
        "selector": "a[href*='.apk'], a:has-text('下载'), button:has-text('下载')"
      }
    ]
  },
  "execution": {
    "mode": "FULL",
    "proxySecretVersionId": "11111111-1111-4111-8111-111111111111",
    "deviceProfiles": [
      {
        "id": "pixel6-api35",
        "name": "Pixel 6 Android 15 测试配置",
        "avdDevice": "pixel_6",
        "systemImage": "system-images;android-35;google_apis;x86_64",
        "locale": "en-US"
      }
    ],
    "contentIsolation": true,
    "appOpen": {
      "dwellMs": 10000,
      "concurrency": 2,
      "appsPerDevice": {
        "min": 3,
        "max": 5
      },
      "randomDeviceProfile": true,
      "ownedTestClient": true
    }
  },
  "registrationFlows": []
}
