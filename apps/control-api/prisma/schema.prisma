generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id                String       @id @default(uuid()) @db.Uuid
  singleton         Int          @unique @default(1)
  username          String       @unique @db.VarChar(64)
  passwordHash      String       @db.VarChar(512)
  credentialVersion Int          @default(1)
  createdAt         DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @db.Timestamptz(3)
  sessions          Session[]
  auditEvents       AuditEvent[]
}

model Session {
  id                String    @id @default(uuid()) @db.Uuid
  adminId           String    @db.Uuid
  admin             Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tokenHash         String    @unique @db.Char(64)
  credentialVersion Int
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt         DateTime  @db.Timestamptz(3)
  revokedAt         DateTime? @db.Timestamptz(3)

  @@index([adminId, revokedAt])
  @@index([expiresAt])
}

model AuditEvent {
  id        String   @id @default(uuid()) @db.Uuid
  adminId   String?  @db.Uuid
  admin     Admin?   @relation(fields: [adminId], references: [id], onDelete: SetNull)
  action    String   @db.VarChar(64)
  requestId String   @db.VarChar(64)
  details   Json?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([createdAt, id])
}

model LoginBucket {
  key         String   @id @db.Char(64)
  windowStart DateTime @db.Timestamptz(3)
  attempts    Int
}

model Node {
  id                      String           @id @default(uuid()) @db.Uuid
  name                    String           @db.VarChar(100)
  host                    String           @db.VarChar(253)
  createdAt               DateTime         @default(now()) @db.Timestamptz(3)
  runs                    Run[]
  port                    Int              @default(22)
  username                String           @default("ubuntu") @db.VarChar(64)
  credentialVersionId     String?          @db.Uuid
  credential              SecretVersion?   @relation("sshCredential", fields: [credentialVersionId], references: [id], onDelete: Restrict)
  sudoCredentialVersionId String?          @db.Uuid
  sudoCredential          SecretVersion?   @relation("sudoCredential", fields: [sudoCredentialVersionId], references: [id], onDelete: Restrict)
  version                 Int              @default(1)
  archivedAt              DateTime?        @db.Timestamptz(3)
  expectedFingerprint     String?          @db.VarChar(100)
  hostKey                 String?
  deploymentStatus        String           @default("NOT_INSTALLED") @db.VarChar(32)
  lastSeenAt              DateTime?        @db.Timestamptz(3)
  health                  Json?
  agentVersion            String?          @db.VarChar(32)
  agentReleaseId          String?          @db.Uuid
  downloadProtocol        String?          @db.VarChar(16)
  registrationProtocol    String?          @db.VarChar(16)
  currentDeliveryId       String?          @db.Uuid
  slot                    NodeSlot?
  operations              Deployment[]
  enrollments             Enrollment[]
  agentCredential         AgentCredential?
}

model SecretVersion {
  id        String    @id @default(uuid()) @db.Uuid
  type      String    @db.VarChar(32)
  keyId     String    @db.VarChar(64)
  encrypted Json
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  createdBy String    @db.Uuid
  sshNodes  Node[]    @relation("sshCredential")
  sudoNodes Node[]    @relation("sudoCredential")
}

model Release {
  id           String       @id @db.Uuid
  manifest     Json
  artifactName String       @unique @db.VarChar(160)
  sha256       String       @unique @db.Char(64)
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  deployments  Deployment[]
}

model NodeSlot {
  nodeId      String  @id @db.Uuid
  node        Node    @relation(fields: [nodeId], references: [id], onDelete: Restrict)
  operationId String? @unique @db.Uuid
  runId       String? @unique @db.Uuid
  quarantined Boolean @default(false)
  fence       Int     @default(0)
}

model Deployment {
  id                String            @id @default(uuid()) @db.Uuid
  nodeId            String            @db.Uuid
  node              Node              @relation(fields: [nodeId], references: [id], onDelete: Restrict)
  nodeVersion       Int
  kind              String            @db.VarChar(20)
  status            String            @default("QUEUED") @db.VarChar(32)
  releaseId         String?           @db.Uuid
  release           Release?          @relation(fields: [releaseId], references: [id], onDelete: Restrict)
  createdBy         String            @db.Uuid
  createdAt         DateTime          @default(now()) @db.Timestamptz(3)
  finishedAt        DateTime?         @db.Timestamptz(3)
  stopRequested     Boolean           @default(false)
  licenseAcceptedAt DateTime?         @db.Timestamptz(3)
  workerId          String?           @db.Uuid
  fence             Int               @default(0)
  leaseExpiresAt    DateTime?         @db.Timestamptz(3)
  result            Json?
  errorCode         String?           @db.VarChar(64)
  events            DeploymentEvent[]
  enrollment        Enrollment?

  @@index([status, createdAt])
}

model DeploymentEvent {
  id           String     @id @default(uuid()) @db.Uuid
  deploymentId String     @db.Uuid
  deployment   Deployment @relation(fields: [deploymentId], references: [id], onDelete: Restrict)
  sequence     Int
  status       String     @db.VarChar(32)
  code         String     @db.VarChar(64)
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)

  @@unique([deploymentId, sequence])
}

model Enrollment {
  id           String     @id @default(uuid()) @db.Uuid
  nodeId       String     @db.Uuid
  node         Node       @relation(fields: [nodeId], references: [id], onDelete: Restrict)
  deploymentId String     @unique @db.Uuid
  deployment   Deployment @relation(fields: [deploymentId], references: [id], onDelete: Restrict)
  tokenHash    String     @unique @db.Char(64)
  expiresAt    DateTime   @db.Timestamptz(3)
  consumedAt   DateTime?  @db.Timestamptz(3)
  bootId       String?    @db.Uuid
}

model AgentCredential {
  nodeId    String    @id @db.Uuid
  node      Node      @relation(fields: [nodeId], references: [id], onDelete: Restrict)
  tokenHash String    @unique @db.Char(64)
  releaseId String    @db.Uuid
  bootId    String    @db.Uuid
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
}

model IdempotencyRecord {
  scope       String   @db.VarChar(200)
  key         String   @db.VarChar(128)
  actorId     String   @db.Uuid
  requestHash String   @db.Char(64)
  response    Json
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@id([actorId, scope, key])
}

model Run {
  id                   String         @id @default(uuid()) @db.Uuid
  nodeId               String         @db.Uuid
  node                 Node           @relation(fields: [nodeId], references: [id], onDelete: Restrict)
  status               RunStatus      @default(QUEUED)
  createdAt            DateTime       @default(now()) @db.Timestamptz(3)
  configVersionId      String?        @db.Uuid
  configVersion        ConfigVersion? @relation(fields: [configVersionId], references: [id], onDelete: Restrict)
  configHash           String?        @db.Char(64)
  releaseId            String?        @db.Uuid
  createdBy            String?        @db.Uuid
  supersedesRunId      String?        @db.Uuid
  stopRequested        Boolean        @default(false)
  finishedAt           DateTime?      @db.Timestamptz(3)
  errorCode            String?        @db.VarChar(100)
  cleanupConfirmedAt   DateTime?      @db.Timestamptz(3)
  cleanupBootId        String?        @db.Uuid
  reviewResolvedAt     DateTime?      @db.Timestamptz(3)
  reconciliationReason String?        @db.VarChar(300)
  reconciledBy         String?        @db.Uuid
  discovered           Boolean        @default(false)
  tasks                Task[]
  delivery             Delivery?

  @@index([createdAt, id])
}

model Configuration {
  id        String          @id @default(uuid()) @db.Uuid
  name      String          @db.VarChar(100)
  version   Int             @default(1)
  createdAt DateTime        @default(now()) @db.Timestamptz(3)
  versions  ConfigVersion[]
}

model ConfigVersion {
  id         String        @id @default(uuid()) @db.Uuid
  configId   String        @db.Uuid
  config     Configuration @relation(fields: [configId], references: [id], onDelete: Restrict)
  version    Int
  body       Json
  configHash String        @db.Char(64)
  createdAt  DateTime      @default(now()) @db.Timestamptz(3)
  createdBy  String        @db.Uuid
  runs       Run[]

  @@unique([configId, version])
}

model Delivery {
  id                     String     @id @default(uuid()) @db.Uuid
  runId                  String     @unique @db.Uuid
  run                    Run        @relation(fields: [runId], references: [id], onDelete: Restrict)
  bootId                 String     @db.Uuid
  fence                  Int
  issuedAt               DateTime   @default(now()) @db.Timestamptz(3)
  ackDeadline            DateTime   @db.Timestamptz(3)
  leaseExpiresAt         DateTime   @db.Timestamptz(3)
  acceptedAt             DateTime?  @db.Timestamptz(3)
  appliedThroughSequence Int        @default(0)
  events                 RunEvent[]
  accounts               AccountResult[]
  artifacts              Artifact[]
}

model Task {
  id        String  @id @db.Uuid
  runId     String  @db.Uuid
  run       Run     @relation(fields: [runId], references: [id], onDelete: Restrict)
  targetKey String  @db.Char(64)
  label     String  @db.VarChar(200)
  sourceUrl String  @db.VarChar(4096)
  position  Int
  status    String  @default("QUEUED") @db.VarChar(32)
  apk       Json?
  cacheHit  Boolean @default(false)
  proof     String  @default("NONE") @db.VarChar(32)
  errorCode String? @db.VarChar(100)
  observation Json?
  accountRef String? @db.Uuid
  submissionId String? @unique @db.Uuid
  submittedAt DateTime? @db.Timestamptz(3)
  account AccountResult?
  artifacts Artifact[]
  reviews TaskReview[]

  @@unique([runId, targetKey])
  @@unique([runId, position])
}

model AccountResult {
  accountRef String @id @db.Uuid
  taskId String @unique @db.Uuid
  task Task @relation(fields: [taskId], references: [id], onDelete: Restrict)
  deliveryId String @db.Uuid
  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Restrict)
  fence Int
  encrypted Json
  contentHash String @db.Char(64)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}

model Artifact {
  id String @id @db.Uuid
  taskId String @db.Uuid
  task Task @relation(fields: [taskId], references: [id], onDelete: Restrict)
  deliveryId String @db.Uuid
  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Restrict)
  fence Int
  kind String @db.VarChar(32)
  sha256 String @db.Char(64)
  bytes Int
  storageKey String @unique @db.VarChar(100)
  recordedForReview Boolean @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([taskId, createdAt])
}

model TaskReview {
  id String @id @default(uuid()) @db.Uuid
  taskId String @db.Uuid
  task Task @relation(fields: [taskId], references: [id], onDelete: Restrict)
  outcome String @db.VarChar(32)
  reason String @db.VarChar(1000)
  evidenceIds String[] @db.Uuid
  createdBy String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([taskId, createdAt])
}

model RunEvent {
  id                String   @id @db.Uuid
  deliveryId        String   @db.Uuid
  delivery          Delivery @relation(fields: [deliveryId], references: [id], onDelete: Restrict)
  sequence          Int
  contentHash       String   @db.Char(64)
  body              Json
  recordedForReview Boolean  @default(false)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)

  @@unique([deliveryId, sequence])
}

enum RunStatus {
  QUEUED
  ASSIGNED
  RUNNING
  STOP_REQUESTED
  SUCCEEDED
  PARTIAL_FAILED
  FAILED
  CANCELLED
  NEEDS_REVIEW
}
